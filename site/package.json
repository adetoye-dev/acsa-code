{
  "name": "acsa-code-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The ACSA Code landing page. Deliberately a separate package from the app \u2014 see README.md.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "node scripts/check-page.mjs",
    "make:og": "node scripts/make-og.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.142.0"
  }
}
