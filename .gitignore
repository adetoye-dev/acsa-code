# ── Local AI Models & Sidecar Server Caches ─────────────────────────────────
# Ignore huge downloaded weights (.gguf / .bin) & sidecar runtime files,
# but keep directory structures via .gitkeep
core-engine/models/bin/*
!core-engine/models/bin/.gitkeep

core-engine/models/cache/*
!core-engine/models/cache/.gitkeep

# Model files & weights
*.gguf
*.bin
*.pt
*.safetensors
*.onnx

# Sidecar runtime locks and logs
.sidecar.pid
sidecar.log
*.download
*.part

# ── Execution Sandbox & Verification Gauntlet Artifacts ─────────────────────
.acsa/
# Ignore temporary runtime files created during sandbox test runs
*_sandbox_stdout.log
*_sandbox_stderr.log
sandbox_audit_*.jsonl
ide_staging_*
ide_perf_staging_*
aide_sandbox_*
*.tmp
tmp*

# Local environment: credentials and machine-specific overrides.
# `.env.example` is the tracked template.
.env
.env.*
!.env.example

# App database (created under the user data dir by default, but a repo-local
# ACSA_DATA_DIR would put it here).
acsa.db
acsa.db-wal
acsa.db-shm

# Frozen engine sidecar (built by scripts/build_engine_sidecar.sh; 10 MB+)
.tauri/binaries/
.tauri/engine/
.tauri/engine-codex/
# Language server toolchain (fetched by scripts/fetch_lsp_sidecar.sh; 50 MB+)
# Outside `.tauri/` on purpose — see the note in that script.
.lsp/
