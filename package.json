{
  "name": "acsa-code",
  "private": true,
  "version": "0.2.32",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "cd .tauri && ../node_modules/.bin/tauri dev",
    "build": "tsc && vite build && node scripts/check_generated_classes.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "verify": "npm run lint && npm run typecheck && npm run classes:check && npm run contrast:check && npm test && npm run test:ui",
    "test": "python3 -W error::ResourceWarning -m unittest discover -s tests -t .",
    "test:verbose": "python3 -m unittest discover -s tests -t . -v",
    "preview": "vite preview",
    "tauri": "cd .tauri && ../node_modules/.bin/tauri",
    "notices": "node scripts/generate_third_party_notices.mjs",
    "classes:check": "node scripts/remap-classes.mjs --check",
    "contrast:check": "node scripts/check_contrast.mjs",
    "audit:check": "node scripts/audit_gate.mjs",
    "notices:check": "node scripts/generate_third_party_notices.mjs --check",
    "lint": "eslint src vite-api-guard.ts vite.config.ts --max-warnings=0",
    "test:ui": "vitest run",
    "gui:check": "node scripts/gui-check.mjs",
    "gui:check:editor": "node scripts/editor-app-check.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "dockview": "^8.2.0",
    "dockview-react": "^8.2.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "lucide-react": "^1.43.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  },
  "description": "ACSA Code — a local-first AI engineering workbench: autonomous coding with deterministic verification.",
  "license": "MIT",
  "author": "Adetoye Adewoye",
  "repository": {
    "type": "git",
    "url": "https://github.com/adetoye-dev/acsa-code.git"
  },
  "homepage": "https://github.com/adetoye-dev/acsa-code#readme"
}
